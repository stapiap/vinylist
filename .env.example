# Copia este archivo a .env y llena los valores. Nunca subas .env al repositorio.

# Token personal de Discogs (gratis): https://www.discogs.com/settings/developers
# Solo para desarrollo local. En producción el token vive en la función de Supabase.
VITE_DISCOGS_TOKEN=

# Supabase (nube para la familia). Se activa la sincronización cuando ambos existen.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
